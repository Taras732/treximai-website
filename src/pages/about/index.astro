---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/Button.astro";
import BgVideo from "../../components/BgVideo.astro";
import { t } from "../../i18n/translations";

import heroIcon from "../../assets/images/about/about_hero_icon.svg";
import ctaImg from "../../assets/images/about/about_cta.png";

const tr = t(Astro.currentLocale);
const a = tr.about;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout
  title="Про нас — TreximAI"
  description="Команда TreximAI створює інфраструктуру цифрової логістики в Україні. Платформа об'єднує документи, трекінг, фінанси та аналітику."
>
  {/* Hero */}
  <section class="hero-blue-gradient relative overflow-hidden text-white">
    <!-- Background video (Freepik aerial expressway) — falls back to gradient if mp4 missing -->
    <div class="pointer-events-none absolute inset-0">
      <BgVideo slug="about-hero" poster={heroIcon.src} alt="" class="opacity-30" />
      <div class="absolute inset-0 bg-gradient-to-b from-brand-blue/70 via-brand-blue/85 to-brand-blue-dark"></div>
    </div>
    <img
      src={heroIcon.src}
      alt=""
      class="pointer-events-none absolute -right-20 -top-24 h-[700px] w-[700px] opacity-20"
      aria-hidden="true"
    />
    <div class="container-1280 relative max-w-[860px] py-32 lg:py-40">
      <h1 class="font-display text-[40px] font-bold leading-[1.2] sm:text-[56px] lg:text-[64px] lg:leading-[86px]">
        {a.hero.h1}
      </h1>
      <p class="mt-6 text-[18px] leading-[27px] text-white/90">{a.hero.sub}</p>
      <div class="mt-8">
        <Button modalTrigger="about-hero" variant="primary" size="lg">{a.hero.cta}</Button>
      </div>
    </div>
  </section>

  {/* Decorative TREXIM wordmark scroller (per Figma 487:2698, czfirearms BREN-2 ref) */}
  <section class="relative h-[60vh] overflow-hidden bg-neutral-50" aria-hidden="true">
    <div class="about-wordmark-scroller" data-wordmark-scroller>
      <div class="wordmark-row">
        <img src={heroIcon.src} alt="" class="wordmark-icon" />
        <span class="wordmark-text">TREXIM</span>
      </div>
    </div>
  </section>

  {/* Vision */}
  <section class="bg-neutral-0 py-24">
    <div class="container-1280">
      <span class="inline-block rounded-full border border-brand-orange px-4 py-1.5 text-[14px] font-medium text-brand-orange">
        {a.vision.chip}
      </span>
      <div class="mt-8 max-w-[960px] space-y-4 text-[24px] leading-[1.42] lg:text-[32px] lg:leading-[42px] font-semibold">
        {a.vision.body.map((p) => <p class="vision-reveal">{p}</p>)}
      </div>
      <div class="mt-12 grid grid-cols-1 gap-px bg-neutral-200 md:grid-cols-3">
        {a.vision.stats.map((s) => (
          <div class="bg-white p-10">
            <div class="font-display text-[48px] font-semibold leading-none text-neutral-900 lg:text-[64px]">
              {s.value}
              {s.suffix && <span class="ml-2 text-[20px] font-semibold uppercase text-neutral-500">{s.suffix}</span>}
            </div>
            <p class="mt-4 text-[16px] leading-[24px] text-neutral-500">{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* Values */}
  <section class="bg-neutral-50 py-24">
    <div class="container-1280">
      <span class="inline-block rounded-full border border-brand-orange px-4 py-1.5 text-[14px] font-medium text-brand-orange">
        {a.values.chip}
      </span>
      <!-- Per Figma annotation 696:19699: these cards are future blog-post links.
           Wrapped in <a> placeholders pointing to /blog so the team can plug in slugs later. -->
      <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4">
        {a.values.cards.map((card) => (
          <a href={`${base}/blog`} class="block rounded-[16px] bg-white p-6 transition-shadow hover:shadow-md">
            <div class="mb-6 grid h-12 w-12 place-items-center rounded-full bg-brand-orange/10">
              <span class="block h-5 w-5 rounded-full bg-brand-orange"></span>
            </div>
            <h3 class="text-[20px] font-semibold leading-[1.4] text-neutral-900">{card.title}</h3>
            <p class="mt-3 text-[14px] leading-[20px] text-neutral-500">{card.desc}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* CTA */}
  <section
    id="contact"
    class="relative overflow-hidden bg-neutral-50 py-24"
    style={`background-image: url(${ctaImg.src}); background-size: cover; background-position: right center;`}
  >
    <div class="absolute inset-0 bg-white/85 lg:bg-gradient-to-r lg:from-white lg:via-white/80 lg:to-transparent"></div>
    <div class="container-1280 relative max-w-[700px]">
      <h2 class="text-[28px] font-semibold leading-[1.31] text-neutral-900 lg:text-[32px] lg:leading-[42px]">
        {a.cta.title}
      </h2>
      <p class="mt-4 text-[16px] leading-[24px] text-neutral-500">{a.cta.sub}</p>
      <div class="mt-6">
        <Button modalTrigger="about-cta" variant="primary" size="lg">{a.cta.button}</Button>
      </div>
    </div>
  </section>
</BaseLayout>
