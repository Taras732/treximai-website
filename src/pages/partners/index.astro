---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/Button.astro";
import { t } from "../../i18n/translations";

import heroImg from "../../assets/images/partners/partners_hero.png";
import graphImg from "../../assets/images/partners/partners_graph.png";

const tr = t(Astro.currentLocale);
const p = tr.partners;
---

<BaseLayout
  title="Партнерам — TreximAI"
  description="Партнерство в екосистемі цифрової логістики. Стабільний потік транзакцій, дані для розвитку, нові джерела доходу для страхових, банків, АЗС, EDI, юридичних та IT-компаній."
>
  {/* Hero */}
  <section class="hero-blue-gradient relative overflow-hidden text-white">
    <div class="container-1280 relative grid grid-cols-1 items-center gap-12 py-32 lg:grid-cols-[1fr_500px] lg:py-40">
      <div>
        <h1 class="font-display text-[40px] font-bold leading-[1.2] sm:text-[56px] lg:text-[64px] lg:leading-[86px]">
          {p.hero.h1Line1}<br />{p.hero.h1Line2}
        </h1>
        <p class="mt-6 max-w-[479px] text-[18px] leading-[27px] text-white/90">{p.hero.sub}</p>
        <div class="mt-8">
          <Button href="/contacts" variant="primary" size="lg">{p.hero.cta}</Button>
        </div>
      </div>
      <div class="hidden lg:block">
        <img src={heroImg.src} alt="" class="block w-full" loading="eager" />
      </div>
    </div>
  </section>

  {/* Why partner — 4 reasons */}
  <section class="bg-neutral-0 py-24">
    <div class="container-1280">
      <h2 class="text-[40px] font-bold leading-[1.21] text-neutral-900 lg:text-[48px] lg:leading-[58px]">
        {p.reasons.title}
      </h2>
      <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-2">
        {p.reasons.cards.map((c) => (
          <div class="rounded-[16px] bg-neutral-50 p-8">
            <div class="mb-6 grid h-12 w-12 place-items-center rounded-full bg-brand-orange/10">
              <span class="block h-5 w-5 rounded bg-brand-orange"></span>
            </div>
            <h3 class="text-[24px] font-semibold leading-[1.4] text-neutral-900">{c.title}</h3>
            <p class="mt-3 text-[16px] leading-[24px] text-neutral-500">{c.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* Partner models — 6 segments */}
  <section class="bg-neutral-50 py-24">
    <div class="container-1280">
      <h2 class="text-[40px] font-bold leading-[1.21] text-neutral-900 lg:text-[48px] lg:leading-[58px]">
        {p.models.title}
      </h2>
      <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {p.models.cards.map((c) => (
          <div class="rounded-[16px] border border-neutral-200 bg-white p-8">
            <span class="inline-block rounded-full bg-brand-orange/10 px-3 py-1 text-[12px] font-semibold uppercase text-brand-orange">
              {c.segment}
            </span>
            <h3 class="mt-4 text-[20px] font-semibold leading-[1.4] text-neutral-900">{c.title}</h3>
            <p class="mt-3 text-[14px] leading-[20px] text-neutral-500">{c.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* Market metrics */}
  <section class="bg-neutral-0 py-24">
    <div class="container-1280">
      <h2 class="text-[40px] font-bold leading-[1.21] text-neutral-900 lg:text-[48px] lg:leading-[58px]">
        {p.market.title}
      </h2>
      <div class="mt-12 grid grid-cols-1 gap-12 lg:grid-cols-[1fr_400px]">
        <!-- Primary stats -->
        <div>
          <div class="grid grid-cols-1 gap-px bg-neutral-200 md:grid-cols-3">
            {p.market.primary.map((s) => (
              <div class="bg-white p-8">
                <span class="text-[12px] font-semibold uppercase tracking-wider text-brand-orange">{s.code}</span>
                <div class="mt-2 font-display text-[40px] font-semibold leading-none text-neutral-900 lg:text-[56px]">
                  {s.value}
                  <span class="ml-1 text-[16px] font-semibold uppercase text-neutral-500">{s.suffix}</span>
                </div>
                <p class="mt-3 text-[14px] leading-[20px] text-neutral-500">{s.desc}</p>
              </div>
            ))}
          </div>
          <p class="mt-4 text-[12px] italic text-neutral-400">{p.market.footnote}</p>
          <div class="mt-8">
            <img src={graphImg.src} alt="Market metrics graph" class="block w-full max-w-[640px]" loading="lazy" />
          </div>
        </div>
        <!-- Side stats -->
        <aside class="rounded-[16px] bg-neutral-50 p-8">
          <h3 class="text-[18px] font-semibold text-neutral-900">{p.market.sideTitle}</h3>
          <div class="mt-6 space-y-6">
            {p.market.sideStats.map((s) => (
              <div>
                <div class="font-display text-[28px] font-semibold leading-none text-neutral-900">{s.value}</div>
                <p class="mt-2 text-[14px] text-neutral-500">{s.desc}</p>
              </div>
            ))}
          </div>
          <p class="mt-8 text-[12px] italic leading-[18px] text-neutral-500">{p.market.sideFooter}</p>
        </aside>
      </div>
    </div>
  </section>

  {/* Path to partnership */}
  <section class="bg-neutral-50 py-24">
    <div class="container-1280">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <h2 class="text-[40px] font-bold leading-[1.21] text-neutral-900 lg:text-[48px] lg:leading-[58px]">
          {p.path.title}
        </h2>
        <Button href="/contacts" variant="secondary" size="md">{p.path.cta}</Button>
      </div>
      <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-3">
        {p.path.steps.map((step) => (
          <div class="relative overflow-hidden rounded-[24px] bg-brand-blue p-10 text-white">
            <span class="pointer-events-none absolute right-4 top-4 font-display text-[92px] font-semibold leading-none text-white/10 select-none">
              {step.number}
            </span>
            <div class="mb-6 grid h-12 w-12 place-items-center rounded-full bg-white/10">
              <span class="font-display text-[18px] font-semibold">{step.number}</span>
            </div>
            <h3 class="text-[24px] font-semibold leading-[1.31]">{step.title}</h3>
            <p class="mt-4 text-[14px] leading-[20px] text-white/90">{step.body}</p>
            <ul class="mt-4 space-y-2 text-[14px] leading-[20px] text-white/80">
              {step.bullets.map((b) => (
                <li class="flex items-start gap-2">
                  <span class="mt-1.5 inline-block h-1.5 w-1.5 rounded-full bg-brand-orange-light"></span>
                  <span>{b}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
