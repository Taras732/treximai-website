---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import BgVideo from "../components/BgVideo.astro";
import { t } from "../i18n/translations";
import { site } from "../data/site";

import heroImg from "../assets/images/home/home_hero.png";
import heroIcon from "../assets/images/home/home_hero_icon.svg";
import monitoringImg from "../assets/images/home/home_monitoring.png";
import documentsImg from "../assets/images/home/home_documents.png";
import risksImg from "../assets/images/home/home_risks.png";
import analyticsImg from "../assets/images/home/home_analytics.png";
import ctaImg from "../assets/images/home/home_cta.png";

const tr = t(Astro.currentLocale);

// Tab images keyed by tab name (must match translations.ts service keys)
const tabImages = {
  monitoring: monitoringImg.src,
  documents: documentsImg.src,
  risks: risksImg.src,
  analytics: analyticsImg.src,
};
---

<BaseLayout>
  {/* ======================== HERO ======================== */}
  <section class="hero-blue-gradient relative overflow-hidden text-white" data-cursor-blur-host>
    <!-- Background video (Freepik aerial highway) — falls back to poster image if mp4 missing -->
    <div class="pointer-events-none absolute inset-0">
      <BgVideo slug="home-hero" poster={heroImg.src} alt="" class="opacity-30" />
      <div class="absolute inset-0 bg-gradient-to-b from-brand-blue/60 via-brand-blue/80 to-brand-blue-dark"></div>
    </div>
    <!-- Cursor-following blur orb (orange glow). JS attaches a div on mount -->
    <!-- Decorative SVG icon top-left -->
    <img
      src={heroIcon.src}
      alt=""
      class="pointer-events-none absolute -left-10 -top-24 h-[700px] w-[700px] opacity-20 select-none"
      aria-hidden="true"
    />
    <div class="container-1280 relative grid grid-cols-1 gap-15 pt-36 pb-20 lg:grid-cols-2">
      <!-- Left: copy -->
      <div class="max-w-[519px]">
        <h1 class="font-display text-[40px] font-bold leading-[1.2] sm:text-[56px] lg:text-[64px] lg:leading-[86px]">
          {tr.hero.h1Line1}<br />{tr.hero.h1Line2}
        </h1>
        <p class="mt-6 max-w-[479px] text-[18px] leading-[27px] text-white/90">
          {tr.hero.sub}
        </p>
        <div class="mt-8">
          <Button modalTrigger="home-hero" variant="primary" size="lg">
            {tr.hero.cta}
          </Button>
        </div>
      </div>

      <!-- Right: browser-mock product preview -->
      <div class="relative hidden lg:block">
        <div class="rounded-[16px] bg-white/5 p-3 backdrop-blur-md ring-1 ring-white/10">
          <div class="flex items-center gap-2 px-2 py-2">
            <span class="block h-3 w-3 rounded-full bg-[#D8695B]"></span>
            <span class="block h-3 w-3 rounded-full bg-[#EAC213]"></span>
            <span class="block h-3 w-3 rounded-full bg-[#79C743]"></span>
            <div class="ml-3 rounded-full bg-white/10 px-3 py-1 text-[10px] text-white/70">trexim.ai</div>
          </div>
          <img src={heroImg.src} alt="Trexim platform preview" class="block w-full rounded-[10px]" />
        </div>
      </div>
    </div>
  </section>

  {/* ======================== STATS — Trexim у цифрах ======================== */}
  <section class="bg-neutral-0 py-24">
    <div class="container-1280 grid grid-cols-1 gap-10 lg:grid-cols-[410px_1fr]">
      <h2 class="text-[40px] font-bold leading-[1.21] text-neutral-900 lg:text-[48px] lg:leading-[58px]">
        {tr.stats.title}
      </h2>
      <div class="grid grid-cols-2 gap-px bg-neutral-200 lg:grid-cols-3">
        {tr.stats.cards.map((card, idx) => (
          <div class="bg-white p-10">
            <div class="font-display text-[64px] font-semibold leading-none text-neutral-900 lg:text-[92px]">
              {card.value}
              {card.suffix && (
                <span class="ml-1 align-baseline text-[24px] font-semibold uppercase">{card.suffix}</span>
              )}
            </div>
            <p class="mt-3 text-[16px] leading-[24px] text-neutral-500">{card.desc}</p>
          </div>
        ))}
        <!-- 5th cell: secondary CTA card -->
        <div class="flex items-center justify-center bg-white p-10">
          <Button modalTrigger="home-stats" variant="secondary" size="md">
            {tr.stats.cta}
          </Button>
        </div>
      </div>
    </div>
  </section>

  {/* ======================== SERVICES TABS (dark) ======================== */}
  <section class="bg-brand-blue-dark text-white" id="services">
    <div class="container-1280 py-24 lg:pb-30">
      <!-- Tabs row -->
      <div class="flex flex-wrap gap-8 border-b border-white/10" data-tabs>
        {tr.services.tabs.map((label, idx) => (
          <button
            type="button"
            class={`relative pb-4 text-[20px] font-semibold transition-colors ${idx === 0 ? "text-white" : "text-white/60 hover:text-white"}`}
            data-tab-key={["monitoring", "documents", "risks", "analytics"][idx]}
            data-tab-active={idx === 0 ? "true" : "false"}
          >
            {label}
            <span
              class={`absolute -bottom-px left-0 right-0 h-0.5 transition-colors ${idx === 0 ? "bg-brand-orange" : "bg-transparent"}`}
              data-tab-underline
            ></span>
          </button>
        ))}
      </div>

      <!-- Tab panels -->
      <div class="mt-12 grid grid-cols-1 gap-15 lg:grid-cols-[519px_1fr]">
        <!-- Left: text panel (only one visible at a time) -->
        <div class="space-y-6">
          {(["monitoring", "documents", "risks", "analytics"] as const).map((key, idx) => (
            <div data-panel={key} class={idx === 0 ? "block" : "hidden"}>
              <h3 class="text-[28px] font-semibold leading-[1.31] lg:text-[32px] lg:leading-[42px]">
                {tr.services[key].title}
              </h3>
              <div class="mt-4 flex flex-wrap gap-2">
                {tr.services[key].chips.map((chip) => (
                  <span class="rounded-full bg-white/10 px-3 py-1 text-[14px]">{chip}</span>
                ))}
              </div>
              <div class="mt-6 space-y-4">
                {tr.services[key].body.map((p) => (
                  <p class="text-[16px] leading-[24px] text-white/90">{p}</p>
                ))}
              </div>
            </div>
          ))}
        </div>

        <!-- Right: image panel (rotates) -->
        <div class="relative">
          <div class="rounded-[24px] bg-white/5 p-3 backdrop-blur-md ring-1 ring-white/10">
            {(["monitoring", "documents", "risks", "analytics"] as const).map((key, idx) => (
              <img
                src={tabImages[key]}
                alt={tr.services[key].title}
                data-panel-img={key}
                class={`block w-full rounded-[16px] ${idx === 0 ? "" : "hidden"}`}
                loading="lazy"
              />
            ))}
          </div>
        </div>
      </div>
    </div>

    <script>
      // Simple tab switcher — no external state management
      const buttons = document.querySelectorAll<HTMLButtonElement>("[data-tab-key]");
      const panels = document.querySelectorAll<HTMLElement>("[data-panel]");
      const panelImgs = document.querySelectorAll<HTMLImageElement>("[data-panel-img]");
      buttons.forEach((btn) => {
        btn.addEventListener("click", () => {
          const key = btn.getAttribute("data-tab-key");
          buttons.forEach((b) => {
            const active = b === btn;
            b.dataset.tabActive = active ? "true" : "false";
            b.classList.toggle("text-white", active);
            b.classList.toggle("text-white/60", !active);
            const underline = b.querySelector<HTMLElement>("[data-tab-underline]");
            if (underline) {
              underline.classList.toggle("bg-brand-orange", active);
              underline.classList.toggle("bg-transparent", !active);
            }
          });
          panels.forEach((p) => {
            const match = p.getAttribute("data-panel") === key;
            p.classList.toggle("hidden", !match);
            p.classList.toggle("block", match);
          });
          panelImgs.forEach((img) => {
            const match = img.getAttribute("data-panel-img") === key;
            img.classList.toggle("hidden", !match);
          });
        });
      });
    </script>
  </section>

  {/* ======================== AUDIENCE — Trexim для учасників ======================== */}
  <section class="bg-neutral-0 py-24">
    <div class="container-1280">
      <h2 class="text-center text-[40px] font-bold leading-[1.21] text-neutral-900 lg:text-[48px] lg:leading-[58px]">
        {tr.audience.title}
      </h2>

      <!-- Block 1: shippers -->
      <div class="mt-16 grid grid-cols-1 gap-15 lg:grid-cols-2 lg:items-center">
        <div class="aspect-video overflow-hidden rounded-[16px] bg-brand-blue-dark">
          <BgVideo slug="home-audience-shippers" poster={heroImg.src} alt="Перевезення вантажу" />
        </div>
        <div>
          <h3 class="text-[28px] font-semibold leading-[1.31] text-neutral-900 lg:text-[32px] lg:leading-[42px]">
            {tr.audience.shippers.h3}
          </h3>
          <p class="mt-4 text-[14px] leading-[20px] text-neutral-500">
            {tr.audience.shippers.lead}
          </p>
          <div class="mt-8 space-y-6 border-l-2 border-brand-orange-light pl-6">
            {tr.audience.shippers.items.map((item) => (
              <div>
                <p class="text-[18px] font-semibold text-neutral-900">{item.title}</p>
                <p class="mt-1 text-[14px] text-neutral-500">{item.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Block 2: logistics companies -->
      <div class="mt-16 grid grid-cols-1 gap-15 lg:grid-cols-2 lg:items-center">
        <div class="order-1 lg:order-2 aspect-video overflow-hidden rounded-[16px] bg-brand-blue-dark">
          <BgVideo slug="home-audience-logistics" poster={heroImg.src} alt="Логістична компанія" />
        </div>
        <div class="order-2 lg:order-1">
          <h3 class="text-[28px] font-semibold leading-[1.31] text-neutral-900 lg:text-[32px] lg:leading-[42px]">
            {tr.audience.logistics.h3}
          </h3>
          <p class="mt-4 text-[14px] leading-[20px] text-neutral-500">
            {tr.audience.logistics.lead}
          </p>
          <div class="mt-8 space-y-6 border-l-2 border-brand-orange-light pl-6">
            {tr.audience.logistics.items.map((item) => (
              <div>
                <p class="text-[18px] font-semibold text-neutral-900">{item.title}</p>
                <p class="mt-1 text-[14px] text-neutral-500">{item.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ======================== PROCESS — Як працює ======================== */}
  <section class="bg-neutral-50 py-24">
    <div class="container-1280">
      <h2 class="text-[40px] font-bold leading-[1.21] text-neutral-900 lg:text-[48px] lg:leading-[58px]">
        {tr.process.title}
      </h2>

      <div class="process-grid relative mt-12 grid grid-cols-1 gap-6 md:grid-cols-3" data-process-grid>
        <div class="process-rail hidden md:block"></div>
        {tr.process.steps.map((step) => (
          <div class="process-step relative overflow-hidden rounded-[24px] bg-brand-blue p-10 text-white" data-process-step>
            <span class="process-watermark pointer-events-none absolute right-4 top-4 font-display text-[92px] font-semibold leading-none select-none">
              {step.number}
            </span>
            <div class="mb-6 grid h-12 w-12 place-items-center rounded-full bg-white/10">
              <span class="font-display text-[18px] font-semibold">{step.number}</span>
            </div>
            <h3 class="text-[24px] font-semibold leading-[1.31] lg:text-[28px]">{step.title}</h3>
            <div class="mt-4 space-y-3">
              {step.body.map((p) => (
                <p class="text-[14px] leading-[20px] text-white/90">{p}</p>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ======================== MARKET — Ринок логістики ======================== */}
  <section class="bg-neutral-0 py-24">
    <div class="container-1280">
      <h2 class="text-[40px] font-bold leading-[1.21] text-neutral-900 lg:text-[48px] lg:leading-[58px]">
        {tr.market.title}
      </h2>
      <p class="mt-4 max-w-[640px] text-[18px] leading-[27px] text-neutral-500">
        {tr.market.sub}
      </p>

      <div class="mt-12 grid grid-cols-2 gap-px bg-neutral-200 lg:grid-cols-4">
        {tr.market.cards.map((card) => (
          <div class="bg-white p-10">
            <div class="font-display text-[48px] font-semibold leading-none text-neutral-900 lg:text-[64px]">
              {card.value}
              {"suffix" in card && card.suffix && (
                <span class="ml-1 text-[24px] font-semibold uppercase">{card.suffix}</span>
              )}
            </div>
            <p class="mt-4 text-[14px] leading-[20px] text-neutral-500">{card.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ======================== CTA + CONTACT FORM ======================== */}
  <section
    id="contact"
    class="relative overflow-hidden bg-neutral-50 py-24"
    style={`background-image: url(${ctaImg.src}); background-size: cover; background-position: right center;`}
  >
    <div class="absolute inset-0 bg-white/85 lg:bg-gradient-to-r lg:from-white lg:to-white/40"></div>
    <div class="container-1280 relative grid grid-cols-1 gap-12 lg:grid-cols-2">
      <!-- Left -->
      <div>
        <h2 class="text-[40px] font-bold leading-[1.21] text-neutral-900 lg:text-[48px] lg:leading-[58px]">
          {tr.cta.title}
        </h2>
        <p class="mt-6 text-[18px] leading-[27px] text-neutral-500 whitespace-pre-line">{tr.cta.sub}</p>
        <div class="mt-8 space-y-3 text-[18px] text-neutral-900">
          <a href={`tel:${site.phone}`} class="block font-semibold">{site.phoneFormatted}</a>
          <a href={`mailto:${site.email}`} class="block hover:text-brand-orange">{site.email}</a>
        </div>
      </div>

      <!-- Right form -->
      <form
        action="https://formspree.io/f/PLACEHOLDER"
        method="POST"
        class="rounded-[16px] border border-neutral-200 bg-white p-8 shadow-sm"
      >
        <label class="block">
          <span class="text-[14px] font-medium text-neutral-700">
            <span class="text-error">*</span> {tr.cta.form.name}
          </span>
          <input type="text" name="name" required class="mt-2 block w-full rounded-[10px] border border-neutral-300 px-4 py-3 text-[16px] focus:border-brand-orange focus:outline-none" />
        </label>
        <label class="mt-4 block">
          <span class="text-[14px] font-medium text-neutral-700">
            <span class="text-error">*</span> {tr.cta.form.phone}
          </span>
          <div class="mt-2 flex">
            <span class="inline-flex items-center rounded-l-[10px] border border-r-0 border-neutral-300 bg-neutral-50 px-4 text-[16px] text-neutral-600">
              🇺🇦 +380
            </span>
            <input type="tel" name="phone" required pattern="[0-9 ]{9,15}" class="block w-full rounded-r-[10px] border border-neutral-300 px-4 py-3 text-[16px] focus:border-brand-orange focus:outline-none" />
          </div>
        </label>
        <label class="mt-4 block">
          <span class="text-[14px] font-medium text-neutral-700">{tr.cta.form.message}</span>
          <textarea
            name="message"
            rows="4"
            maxlength="100"
            placeholder={tr.cta.form.messagePlaceholder}
            class="mt-2 block w-full rounded-[10px] border border-neutral-300 px-4 py-3 text-[16px] focus:border-brand-orange focus:outline-none"
          ></textarea>
          <span class="mt-1 block text-right text-[12px] text-neutral-400" data-counter>0 / 100</span>
        </label>
        <Button type="submit" variant="primary" size="lg" fullWidth class="mt-6">
          {tr.cta.form.submit}
        </Button>
      </form>
    </div>
  </section>

  {/* ======================== NEWS ======================== */}
  <section class="bg-neutral-0 py-24">
    <div class="container-1280">
      <div class="flex items-end justify-between gap-4">
        <h2 class="text-[40px] font-bold leading-[1.21] text-neutral-900 lg:text-[48px] lg:leading-[58px]">
          {tr.news.title}
        </h2>
        <Button href="/blog" variant="secondary" size="md">
          {tr.news.viewAll}
        </Button>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-3">
        {tr.news.placeholderArticles.map((article) => (
          <article class="overflow-hidden rounded-[16px] border border-neutral-200 bg-white">
            <div class="aspect-video bg-gradient-to-br from-brand-blue to-brand-blue-dark"></div>
            <div class="p-6">
              <p class="text-[12px] uppercase tracking-wide text-neutral-400">{article.date}</p>
              <h3 class="mt-2 text-[20px] font-semibold leading-[1.4] text-neutral-900">
                {article.title}
              </h3>
              <div class="mt-4 flex flex-wrap gap-2">
                {article.tags.map((tag) => (
                  <span class="rounded-full bg-neutral-50 px-3 py-1 text-[12px] text-neutral-600">{tag}</span>
                ))}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Char counter for message textarea
  const ta = document.querySelector<HTMLTextAreaElement>('textarea[name="message"]');
  const counter = document.querySelector<HTMLElement>("[data-counter]");
  if (ta && counter) {
    ta.addEventListener("input", () => {
      counter.textContent = `${ta.value.length} / 100`;
    });
  }
</script>
