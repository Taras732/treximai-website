---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/Button.astro";
import { t } from "../../i18n/translations";
import { articles, getRelated } from "../../data/articles";

export async function getStaticPaths() {
  return articles.map((a) => ({ params: { slug: a.slug }, props: { article: a } }));
}

interface Props {
  article: (typeof articles)[number];
}

const { article } = Astro.props;
const tr = t(Astro.currentLocale);
const b = tr.blog;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const related = getRelated(article, 3);
---

<BaseLayout title={`${article.title} — Блог TreximAI`} description={article.excerpt}>
  {/* Hero — title + meta */}
  <section class="hero-blue-gradient text-white">
    <div class="container-1280 max-w-[860px] py-24 lg:py-28">
      <a href={`${base}/blog`} class="text-[14px] text-white/70 hover:text-white">← {b.title}</a>
      <h1 class="mt-4 font-display text-[36px] font-bold leading-[1.2] lg:text-[48px] lg:leading-[58px]">
        {article.title}
      </h1>
      <div class="mt-6 flex flex-wrap items-center gap-4 text-[14px] text-white/80">
        <span>{article.dateLabel}</span>
        <span>·</span>
        <span>{b.readingTime(article.readingTimeMin)}</span>
      </div>
      <div class="mt-4 flex flex-wrap gap-2">
        {article.tags.map((tag) => (
          <span class="rounded-full border border-white/30 px-3 py-1 text-[12px] text-white/90">{tag}</span>
        ))}
      </div>
    </div>
  </section>

  {/* Body */}
  <article class="bg-neutral-0 py-16">
    <div class="container-1280 max-w-[760px]">
      <p class="text-[18px] leading-[28px] text-neutral-700">{article.excerpt}</p>
      <div class="mt-12 space-y-10">
        {article.body.map((section) => (
          <section>
            {section.h3 && (
              <h3 class="text-[24px] font-semibold leading-[1.4] text-neutral-900 lg:text-[28px]">{section.h3}</h3>
            )}
            <div class="mt-4 space-y-4 text-[16px] leading-[26px] text-neutral-700">
              {section.paragraphs.map((p) => <p>{p}</p>)}
            </div>
            {section.bullets && (
              <ul class="mt-4 space-y-2">
                {section.bullets.map((bullet) => (
                  <li class="flex items-start gap-3 text-[16px] leading-[24px] text-neutral-700">
                    <span class="mt-2 inline-block h-1.5 w-1.5 rounded-full bg-brand-orange"></span>
                    <span>{bullet}</span>
                  </li>
                ))}
              </ul>
            )}
          </section>
        ))}
      </div>
    </div>
  </article>

  {/* Related */}
  {related.length > 0 && (
    <section class="bg-neutral-50 py-16">
      <div class="container-1280">
        <h2 class="text-[28px] font-semibold leading-[1.4] text-neutral-900 lg:text-[32px]">{b.relatedTitle}</h2>
        <div class="mt-8 grid grid-cols-1 gap-6 md:grid-cols-3">
          {related.map((a) => (
            <article class="overflow-hidden rounded-[16px] border border-neutral-200 bg-white">
              <a href={`${base}/blog/${a.slug}`} class="block">
                <div class="aspect-video bg-gradient-to-br from-brand-blue to-brand-blue-dark"></div>
                <div class="p-6">
                  <p class="text-[12px] uppercase tracking-wide text-neutral-400">{a.dateLabel}</p>
                  <h3 class="mt-2 text-[18px] font-semibold leading-[1.4] text-neutral-900">{a.title}</h3>
                </div>
              </a>
            </article>
          ))}
        </div>
        <div class="mt-8">
          <Button href={`${base}/blog`} variant="secondary" size="md">← {b.title}</Button>
        </div>
      </div>
    </section>
  )}
</BaseLayout>
