---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/Button.astro";
import { t } from "../../i18n/translations";
import { site } from "../../data/site";

const tr = t(Astro.currentLocale);
const c = tr.contacts;
const f = tr.cta.form;
---

<BaseLayout
  title="Контакти — TreximAI"
  description="Зв'яжіться з командою TreximAI. Розкажіть про ваші потреби в логістиці — ми відповімо протягом 24 годин."
>
  {/* Hero */}
  <section class="hero-blue-gradient relative overflow-hidden text-white">
    <div class="container-1280 relative max-w-[860px] py-24 lg:py-32">
      <h1 class="font-display text-[40px] font-bold leading-[1.2] sm:text-[56px] lg:text-[64px] lg:leading-[86px]">
        {c.hero.h1}
      </h1>
      <p class="mt-6 max-w-[640px] text-[18px] leading-[27px] text-white/90">{c.hero.sub}</p>
    </div>
  </section>

  {/* Form section */}
  <section class="bg-neutral-0 py-24">
    <div class="container-1280 grid grid-cols-1 gap-12 lg:grid-cols-2">
      <div>
        <h2 class="text-[28px] font-semibold leading-[1.31] text-neutral-900 lg:text-[32px] lg:leading-[42px]">
          {tr.cta.title}
        </h2>
        <div class="mt-6 space-y-4 text-[16px] text-neutral-900">
          <a href={`tel:${site.phone}`} class="block hover:text-brand-orange">{site.phoneFormatted}</a>
          <a href={`mailto:${site.email}`} class="block hover:text-brand-orange">{site.email}</a>
        </div>
      </div>

      <form
        action="https://formspree.io/f/PLACEHOLDER"
        method="POST"
        class="rounded-[16px] border border-neutral-200 bg-white p-8 shadow-sm"
      >
        <label class="block">
          <span class="text-[14px] font-medium text-neutral-700">
            <span class="text-error">*</span> {f.name}
          </span>
          <input type="text" name="name" required class="mt-2 block w-full rounded-[10px] border border-neutral-300 px-4 py-3 text-[16px] focus:border-brand-orange focus:outline-none" />
        </label>
        <label class="mt-4 block">
          <span class="text-[14px] font-medium text-neutral-700">
            <span class="text-error">*</span> {f.phone}
          </span>
          <div class="mt-2 flex">
            <span class="inline-flex items-center rounded-l-[10px] border border-r-0 border-neutral-300 bg-neutral-50 px-4 text-[16px] text-neutral-600">
              🇺🇦 +380
            </span>
            <input type="tel" name="phone" required class="block w-full rounded-r-[10px] border border-neutral-300 px-4 py-3 text-[16px] focus:border-brand-orange focus:outline-none" />
          </div>
        </label>
        <label class="mt-4 block">
          <span class="text-[14px] font-medium text-neutral-700">{f.message}</span>
          <textarea
            name="message"
            rows="4"
            maxlength="100"
            placeholder={f.messagePlaceholder}
            class="mt-2 block w-full rounded-[10px] border border-neutral-300 px-4 py-3 text-[16px] focus:border-brand-orange focus:outline-none"
          ></textarea>
        </label>
        <Button type="submit" variant="primary" size="lg" fullWidth class="mt-6">{f.submit}</Button>
      </form>
    </div>
  </section>

  {/* Що буде далі — 4 cards */}
  <section class="bg-neutral-50 py-24">
    <div class="container-1280">
      <h2 class="text-[40px] font-bold leading-[1.21] text-neutral-900 lg:text-[48px] lg:leading-[58px]">
        {c.next.title}
      </h2>
      <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4">
        {c.next.cards.map((card, idx) => (
          <div class="rounded-[16px] bg-white p-6">
            <div class="mb-6 grid h-12 w-12 place-items-center rounded-full bg-brand-orange/10 font-display text-[18px] font-semibold text-brand-orange">
              {String(idx + 1).padStart(2, "0")}
            </div>
            <h3 class="text-[18px] font-semibold leading-[1.4] text-neutral-900">{card.title}</h3>
            <p class="mt-3 text-[14px] leading-[20px] text-neutral-500">{card.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* Локація + контакти */}
  <section class="bg-neutral-0 py-24">
    <div class="container-1280">
      <h2 class="text-[40px] font-bold leading-[1.21] text-neutral-900 lg:text-[48px] lg:leading-[58px]">
        {c.location.title}
      </h2>
      <dl class="mt-8 grid grid-cols-1 gap-6 md:grid-cols-3">
        <div>
          <dt class="text-[14px] font-semibold uppercase tracking-wider text-neutral-400">{c.location.addressLabel}</dt>
          <dd class="mt-2 text-[18px] text-neutral-900">{site.address}</dd>
        </div>
        <div>
          <dt class="text-[14px] font-semibold uppercase tracking-wider text-neutral-400">{c.location.phoneLabel}</dt>
          <dd class="mt-2 text-[18px]">
            <a href={`tel:${site.phone}`} class="text-neutral-900 hover:text-brand-orange">{site.phoneFormatted}</a>
          </dd>
        </div>
        <div>
          <dt class="text-[14px] font-semibold uppercase tracking-wider text-neutral-400">{c.location.emailLabel}</dt>
          <dd class="mt-2 text-[18px]">
            <a href={`mailto:${site.email}`} class="text-neutral-900 hover:text-brand-orange">{site.email}</a>
          </dd>
        </div>
      </dl>
    </div>
  </section>
</BaseLayout>
