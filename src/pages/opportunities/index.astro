---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/Button.astro";
import BgVideo from "../../components/BgVideo.astro";
import { t } from "../../i18n/translations";

import heroGlass from "../../assets/images/opportunities/opp_hero_glass.svg";
import imgRoutes from "../../assets/images/opportunities/opp_routes.png";
import imgDocuments from "../../assets/images/opportunities/opp_documents.png";
import imgFinancial from "../../assets/images/opportunities/opp_financial.png";
import imgFleet from "../../assets/images/opportunities/opp_fleet.png";
import ctaImg from "../../assets/images/opportunities/opp_cta.png";

const tr = t(Astro.currentLocale);
const o = tr.opp;

const featureImages: Record<string, string> = {
  routes: imgRoutes.src,
  documents: imgDocuments.src,
  financial: imgFinancial.src,
  fleet: imgFleet.src,
};
---

<BaseLayout
  title="Можливості — TreximAI"
  description="Практичні рішення для автоматизації логістики: оптимізація маршрутів, документообіг, фінанси, управління автопарком."
>
  {/* Hero */}
  <section class="hero-blue-gradient relative overflow-hidden text-white">
    <!-- Background video (Freepik aerial sunset rural highway) — falls back to glass-effect SVG only -->
    <div class="pointer-events-none absolute inset-0">
      <BgVideo slug="opportunities-hero" poster={heroGlass.src} alt="" class="opacity-25" />
      <div class="absolute inset-0 bg-gradient-to-b from-brand-blue/65 via-brand-blue/80 to-brand-blue-dark"></div>
    </div>
    <img
      src={heroGlass.src}
      alt=""
      class="pointer-events-none absolute inset-0 h-full w-full opacity-30"
      aria-hidden="true"
    />
    <div class="container-1280 relative py-32 text-center lg:py-40">
      <h1 class="mx-auto max-w-[600px] font-display text-[40px] font-bold leading-[1.2] sm:text-[56px] lg:text-[64px] lg:leading-[86px]">
        {o.hero.h1Line1}<br />{o.hero.h1Line2}
      </h1>
      <p class="mx-auto mt-6 max-w-[600px] text-[18px] leading-[27px] text-white/90">
        {o.hero.sub}
      </p>
    </div>
  </section>

  {/* 4 Feature sections — sticky-image scroll pattern per Figma annotation 414:15325
       (https://www.all-forward.com/ reference). Left text scrolls normally; right
       image stays sticky and cross-fades to match the article currently in viewport. */}
  <section class="bg-neutral-0 py-24" data-sticky-features>
    <div class="container-1280 grid grid-cols-1 gap-12 lg:grid-cols-2 lg:items-start lg:gap-16">
      <!-- Left: scrolling text articles -->
      <div class="space-y-32 lg:space-y-48">
        {o.features.map((f) => (
          <article data-feature-text={f.key}>
            <h2 class="text-[32px] font-semibold leading-[1.31] text-neutral-900 lg:text-[40px] lg:leading-[54px]">
              {f.title}
            </h2>
            <p class="mt-4 text-[16px] leading-[24px] text-neutral-500">{f.body}</p>
            <ul class="mt-6 space-y-3">
              {f.bullets.map((b) => (
                <li class="flex items-start gap-3 text-[16px] text-neutral-900">
                  <span class="mt-2 inline-block h-1.5 w-1.5 rounded-full bg-brand-orange"></span>
                  <span>{b}</span>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>

      <!-- Right: sticky image holder with cross-fade between feature panels -->
      <div class="hidden lg:block">
        <div class="sticky top-32 aspect-[4/3] overflow-hidden rounded-[16px] bg-neutral-50 shadow-sm" data-feature-image-holder>
          {o.features.map((f, idx) => (
            <img
              src={featureImages[f.key]}
              alt={f.title}
              data-feature-image={f.key}
              class={`absolute inset-0 h-full w-full object-cover transition-opacity duration-500 ${idx === 0 ? "opacity-100" : "opacity-0"}`}
              loading={idx === 0 ? "eager" : "lazy"}
            />
          ))}
        </div>
      </div>

      <!-- Mobile fallback: alternating images inline (sticky behavior would feel cramped) -->
      <div class="contents lg:hidden">
        {o.features.map((f) => (
          <img src={featureImages[f.key]} alt={f.title} class="rounded-[16px] shadow-sm" loading="lazy" />
        ))}
      </div>
    </div>
  </section>

  <script>
    // Cross-fade sticky image when the corresponding text article enters the viewport.
    const articles = document.querySelectorAll<HTMLElement>("[data-feature-text]");
    const images = document.querySelectorAll<HTMLImageElement>("[data-feature-image]");
    if (articles.length > 0 && images.length > 0 && "IntersectionObserver" in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          // Pick the entry closest to the middle of the viewport
          const visible = entries.filter((e) => e.isIntersecting);
          if (visible.length === 0) return;
          const top = visible.reduce((a, b) => (a.intersectionRatio > b.intersectionRatio ? a : b));
          const key = (top.target as HTMLElement).dataset.featureText;
          images.forEach((img) => {
            const match = img.dataset.featureImage === key;
            img.style.opacity = match ? "1" : "0";
          });
        },
        { rootMargin: "-30% 0px -40% 0px", threshold: [0, 0.25, 0.5, 0.75, 1] },
      );
      articles.forEach((a) => observer.observe(a));
    }
  </script>

  {/* Extended capabilities */}
  <section class="bg-neutral-0 py-24">
    <div class="container-1280">
      <h2 class="text-[40px] font-bold leading-[1.21] text-neutral-900 lg:text-[48px] lg:leading-[58px]">
        {o.extended.title}
      </h2>
      <p class="mt-4 max-w-[640px] text-[18px] leading-[27px] text-neutral-500">{o.extended.sub}</p>

      <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {o.extended.cards.map((c) => (
          <div class="rounded-[16px] border border-neutral-200 bg-white p-6 transition-colors hover:border-brand-orange">
            <div class="mb-6 grid h-12 w-12 place-items-center rounded-full bg-brand-orange/10">
              <span class="block h-5 w-5 rounded bg-brand-orange"></span>
            </div>
            <h3 class="text-[20px] font-semibold leading-[1.4] text-neutral-900">{c.title}</h3>
            <p class="mt-3 text-[14px] leading-[20px] text-neutral-500">{c.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* CTA */}
  <section
    class="relative overflow-hidden bg-neutral-50 py-24"
    style={`background-image: url(${ctaImg.src}); background-size: cover; background-position: right center;`}
  >
    <div class="absolute inset-0 bg-white/85 lg:bg-gradient-to-r lg:from-white lg:via-white/80 lg:to-transparent"></div>
    <div class="container-1280 relative max-w-[700px]">
      <h2 class="text-[28px] font-semibold leading-[1.31] text-neutral-900 lg:text-[32px] lg:leading-[42px]">
        {o.cta.title}
      </h2>
      <p class="mt-4 text-[16px] leading-[24px] text-neutral-500">{o.cta.sub}</p>
      <div class="mt-6">
        <Button modalTrigger="opportunities-cta" variant="primary" size="lg">{o.cta.button}</Button>
      </div>
    </div>
  </section>
</BaseLayout>
