---
/**
 * Reusable looped background video. Renders <video autoplay muted loop playsinline>.
 * Looks up files in /public/videos/<slug>.{webm,mp4}; falls back to poster image
 * if neither plays. prefers-reduced-motion users see the poster.
 */
interface Props {
  slug: string;
  poster: string;
  alt?: string;
  class?: string;
  objectPosition?: string;
}

const { slug, poster, alt = "", class: extraClass = "", objectPosition = "center" } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<video
  class={`bg-video ${extraClass}`}
  autoplay
  muted
  loop
  playsinline
  preload="metadata"
  poster={poster}
  aria-label={alt}
  style={`object-position: ${objectPosition};`}
>
  <source src={`${base}/videos/${slug}.webm`} type="video/webm" />
  <source src={`${base}/videos/${slug}.mp4`} type="video/mp4" />
</video>

<style>
  .bg-video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media (prefers-reduced-motion: reduce) {
    .bg-video {
      /* Show poster only — pause + reset so it acts like an <img> */
      animation: none;
    }
  }
</style>
