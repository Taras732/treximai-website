---
interface Props {
  href?: string;
  variant?: "primary" | "secondary";
  size?: "md" | "lg";
  type?: "button" | "submit";
  class?: string;
  fullWidth?: boolean;
}

const {
  href,
  variant = "primary",
  size = "md",
  type = "button",
  class: extraClass = "",
  fullWidth = false,
} = Astro.props;

const base =
  "inline-flex items-center justify-center gap-2 font-medium transition-colors rounded-[4px] " +
  "text-[16px]";

const sizeClass =
  size === "lg" ? "px-10 py-5" : "px-10 py-5 md:px-10 md:py-5"; // primary spec is 20/40; tab variant 40/80
const padPrimary = size === "lg" ? "px-10 py-5" : "px-10 py-5";
const padSecondary = size === "lg" ? "px-10 py-5" : "px-6 py-3";

const variants = {
  primary: `bg-brand-orange text-white hover:bg-brand-orange-light ${padPrimary}`,
  secondary: `border border-brand-orange text-brand-orange hover:bg-brand-orange hover:text-white ${padSecondary}`,
};

const cls = `${base} ${variants[variant]} ${fullWidth ? "w-full" : ""} ${extraClass}`;
---

{href ? (
  <a href={href} class={cls}>
    <slot />
  </a>
) : (
  <button type={type} class={cls}>
    <slot />
  </button>
)}
