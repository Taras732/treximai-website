---
import { t } from "../i18n/translations";
import { site } from "../data/site";

const tr = t(Astro.currentLocale);
const m = tr.formModal;
---

<dialog
  id="form-modal"
  class="fixed left-1/2 top-1/2 z-[100] w-full max-w-[480px] -translate-x-1/2 -translate-y-1/2 rounded-[8px] border-0 bg-white p-0 shadow-2xl backdrop:bg-black/60 backdrop:backdrop-blur-sm"
  aria-labelledby="form-modal-title"
>
  <button
    type="button"
    class="absolute right-4 top-4 grid h-8 w-8 place-items-center rounded-full text-neutral-500 hover:bg-neutral-50 hover:text-neutral-900"
    data-modal-close
    aria-label={m.close}
  >
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M6 6l12 12M18 6L6 18" stroke-linecap="round" />
    </svg>
  </button>

  <div class="p-8 pt-12">
    <h2 id="form-modal-title" class="text-[24px] font-semibold leading-[1.31] text-neutral-900 lg:text-[28px]">
      {m.title}
    </h2>
    <p class="mt-3 text-[16px] leading-[24px] text-neutral-500">{m.sub}</p>

    <form
      class="mt-6 space-y-4"
      action="https://formspree.io/f/PLACEHOLDER"
      method="POST"
      data-form-modal
    >
      <input type="hidden" name="source" value="" data-modal-source />

      <label class="block">
        <span class="text-[14px] font-medium text-neutral-700">
          <span class="text-error">*</span> {m.fields.name}
        </span>
        <input
          type="text"
          name="name"
          required
          autocomplete="name"
          class="mt-2 block w-full rounded-[10px] border border-neutral-300 px-4 py-3 text-[16px] focus:border-brand-orange focus:outline-none"
        />
      </label>

      <label class="block">
        <span class="text-[14px] font-medium text-neutral-700">
          <span class="text-error">*</span> {m.fields.phone}
        </span>
        <div class="mt-2 flex">
          <span class="inline-flex items-center rounded-l-[10px] border border-r-0 border-neutral-300 bg-neutral-50 px-4 text-[16px] text-neutral-600">
            🇺🇦 +380
          </span>
          <input
            type="tel"
            name="phone"
            required
            inputmode="numeric"
            autocomplete="tel"
            pattern="[0-9 ]{9,15}"
            class="block w-full rounded-r-[10px] border border-neutral-300 px-4 py-3 text-[16px] focus:border-brand-orange focus:outline-none"
          />
        </div>
      </label>

      <label class="block">
        <span class="text-[14px] font-medium text-neutral-700">
          <span class="text-error">*</span> {m.fields.edrpou}
        </span>
        <input
          type="text"
          name="edrpou"
          required
          inputmode="numeric"
          pattern="[0-9]{8,10}"
          class="mt-2 block w-full rounded-[10px] border border-neutral-300 px-4 py-3 text-[16px] focus:border-brand-orange focus:outline-none"
        />
      </label>

      <input type="hidden" name="_subject" value="New Trexim demo request" />
      <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" style="display:none" />

      <button
        type="submit"
        class="mt-2 w-full rounded-[4px] bg-brand-orange px-10 py-5 text-[16px] font-medium text-white hover:bg-brand-orange-light"
      >
        {m.submit}
      </button>

      <p class="text-center text-[12px] text-neutral-400" data-modal-status></p>
    </form>
  </div>
</dialog>

<script>
  const modal = document.getElementById("form-modal") as HTMLDialogElement | null;
  const sourceInput = document.querySelector<HTMLInputElement>("[data-modal-source]");
  const closeBtn = document.querySelector<HTMLButtonElement>("[data-modal-close]");
  const form = document.querySelector<HTMLFormElement>("[data-form-modal]");
  const statusEl = document.querySelector<HTMLElement>("[data-modal-status]");

  if (!modal) {
    console.warn("FormModal: <dialog> not found");
  } else {
    // Open via any element with [data-modal-trigger]
    document.addEventListener("click", (event) => {
      const target = event.target as HTMLElement | null;
      const trigger = target?.closest<HTMLElement>("[data-modal-trigger]");
      if (!trigger) return;
      event.preventDefault();
      const source = trigger.getAttribute("data-modal-trigger") || "unknown";
      if (sourceInput) sourceInput.value = source;
      modal.showModal();
    });

    closeBtn?.addEventListener("click", () => modal.close());

    // Close on backdrop click (click outside .p-8 inner area)
    modal.addEventListener("click", (event) => {
      if (event.target === modal) modal.close();
    });

    // Submit via fetch to Formspree without leaving the page
    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!form.action.includes("PLACEHOLDER")) {
        try {
          const data = new FormData(form);
          const response = await fetch(form.action, {
            method: form.method,
            body: data,
            headers: { Accept: "application/json" },
          });
          if (response.ok) {
            if (statusEl) statusEl.textContent = "Дякуємо! Ми зв'яжемося з вами протягом 24 годин.";
            form.reset();
            setTimeout(() => modal.close(), 2500);
          } else {
            if (statusEl) statusEl.textContent = "Помилка надсилання. Спробуйте ще раз або напишіть на support@trexim.ai.";
          }
        } catch {
          if (statusEl) statusEl.textContent = "Перевірте інтернет-з'єднання та спробуйте ще раз.";
        }
      } else {
        // Placeholder mode: just confirm visually
        if (statusEl) statusEl.textContent = "Demo-форма ще не підключена до Formspree (placeholder mode).";
      }
    });
  }
</script>
