---
import { site } from "../data/site";
import { t } from "../i18n/translations";

const tr = t(Astro.currentLocale);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<footer class="bg-brand-blue-dark text-white">
  <div class="container-1280 grid grid-cols-1 gap-10 py-16 md:grid-cols-2 lg:grid-cols-4">
    <!-- Col 1 — Brand -->
    <div>
      <a href={`${base}/`} class="inline-flex items-center gap-2" aria-label="TreximAI">
        <span class="font-display text-[22px] font-bold tracking-tight">
          Trexim<span class="text-brand-orange">AI</span>
        </span>
      </a>
      <p class="mt-4 text-[14px] leading-[20px] text-white/80">
        {tr.footer.tagline}
      </p>
      <div class="mt-6 flex items-center gap-4">
        {site.social.linkedin ? (
          <a href={site.social.linkedin} aria-label="LinkedIn" class="hover:text-brand-orange">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14zM8 18V10H5v8h3zM6.5 8.7a1.7 1.7 0 1 0 0-3.5 1.7 1.7 0 0 0 0 3.5zM18 18v-4.7c0-2.5-1.3-3.6-3-3.6-1.4 0-2.1.8-2.4 1.4V10h-3v8h3v-4.4c0-1.2.8-1.8 1.7-1.8.9 0 1.7.6 1.7 1.8V18h3z"/></svg>
          </a>
        ) : null}
        {site.social.facebook ? (
          <a href={site.social.facebook} aria-label="Facebook" class="hover:text-brand-orange">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M22 12a10 10 0 1 0-11.6 9.9V14.9H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.4h-1.2c-1.2 0-1.6.8-1.6 1.6V12h2.7l-.4 2.9h-2.3v7A10 10 0 0 0 22 12z"/></svg>
          </a>
        ) : null}
        {site.social.instagram ? (
          <a href={site.social.instagram} aria-label="Instagram" class="hover:text-brand-orange">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg>
          </a>
        ) : null}
      </div>
    </div>

    <!-- Col 2-3 dynamically rendered -->
    {tr.footer.sections.map((sec) => (
      <div>
        <h4 class="text-[16px] font-semibold mb-4">{sec.title}</h4>
        <ul class="space-y-2">
          {sec.links.map((l) => (
            <li>
              <a href={`${base}${l.href}`} class="text-[16px] text-neutral-400 hover:text-white">
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}

    <!-- Col 4 — Contact -->
    <div>
      <h4 class="text-[16px] font-semibold mb-4">{tr.footer.contact.title}</h4>
      <ul class="space-y-2 text-[16px]">
        <li>
          <a href={`tel:${site.phone}`} class="hover:text-brand-orange">
            {site.phoneFormatted}
          </a>
        </li>
        <li>
          <a href={`mailto:${site.email}`} class="hover:text-brand-orange">
            {site.email}
          </a>
        </li>
        <li class="pt-3">
          <a
            href={`${base}/contacts`}
            class="inline-block rounded border border-brand-orange px-4 py-2 text-brand-orange hover:bg-brand-orange hover:text-white"
          >
            {tr.footer.contact.cta}
          </a>
        </li>
      </ul>
    </div>
  </div>

  <!-- Legal row -->
  <div class="border-t border-white/10">
    <div class="container-1280 flex flex-col items-center justify-between gap-3 py-6 text-[14px] text-white/70 md:flex-row">
      <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
        <a href={`${base}/terms`} class="hover:text-white">{tr.footer.legal.terms}</a>
        <a href={`${base}/privacy`} class="hover:text-white">{tr.footer.legal.privacy}</a>
        <span>{tr.footer.legal.copy}</span>
      </div>
      <div class="flex items-center gap-2">
        <a href={`${base}/`} class="rounded-full bg-white/10 px-3 py-1 text-white">Укр</a>
        <a href={`${base}/en/`} class="text-white/50 hover:text-white">Eng</a>
      </div>
    </div>
  </div>
</footer>
